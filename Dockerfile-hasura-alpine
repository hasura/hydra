# Hasura hardened Alpine image for Hydra v2.x (self-hosted / DDN).
# Built manually and pushed to gcr.io/hasura-ee/hydra.
#
# Versioning: Hasura maintains its own patch version independent of upstream
# Ory tags. Increment the Hasura patch version each time the image is rebuilt
# (e.g. v2.3.1, v2.3.2, …). Append the Alpine version to the tag.
#
# Build & push:
#   docker build -f Dockerfile-hasura-alpine -t gcr.io/hasura-ee/hydra:v2.3.1-alpine3.23.6 .
#   docker push gcr.io/hasura-ee/hydra:v2.3.1-alpine3.23.6

FROM golang:1.26.8-bookworm@sha256:a688600ca24f8a4d3ca77f95b0dd40704a9fc787c826660eb7ba0b641b8b175d AS builder

WORKDIR /go/src/github.com/ory/hydra

ENV GOTOOLCHAIN=local

RUN apt-get update && apt-get upgrade -y && \
    mkdir -p ./internal/httpclient

COPY go.mod go.sum ./
COPY internal/httpclient/go.* ./internal/httpclient/

ENV CGO_ENABLED=1

RUN go mod download

COPY . .
RUN go build -trimpath -ldflags="-extldflags=-static" -tags sqlite,sqlite_omit_load_extension -o /usr/bin/hydra

FROM alpine:3.23.6@sha256:85fe1e81d6758c208f3e1eed4338a1997e19d4be002d4dd32d3100c9a8c010a0

RUN apk add --no-cache --upgrade ca-certificates && \
    addgroup --system --gid 65532 nonroot && \
    adduser --system --uid 65532 \
      --gecos "nonroot User" \
      --home /home/nonroot \
      --ingroup nonroot \
      --shell /sbin/nologin \
      nonroot

COPY --from=builder /usr/bin/hydra /usr/bin/hydra

# set up nsswitch.conf for Go's "netgo" implementation
# - https://github.com/golang/go/blob/go1.9.1/src/net/conf.go#L194-L275
RUN echo 'hosts: files dns' > /etc/nsswitch.conf

USER nonroot

ENTRYPOINT ["hydra"]
CMD ["serve", "all"]
