# Hasura hardened Alpine image for Hydra v2.x (self-hosted / DDN).
# Built manually and pushed to gcr.io/hasura-ee/hydra.
#
# Versioning: Hasura maintains its own patch version independent of upstream
# Ory tags. Increment the Hasura patch version each time the image is rebuilt
# (e.g. v2.3.1, v2.3.2, …). Append the Alpine version to the tag.
#
# Build & push:
#   docker build -f Dockerfile-hasura-alpine -t gcr.io/hasura-ee/hydra:v2.3.4-alpine3.23.7 .
#   docker push gcr.io/hasura-ee/hydra:v2.3.4-alpine3.23.7

# Builder: Hasura-mirrored golang:1.26-bookworm-stable (hasura/external-images).
# Go 1.26.x (>= 1.26.9), Debian 12 bookworm, multi-arch. The alias floats within the
# 1.26 line only; move FROM by hand to the next minor at Go 1.26 end of life.
FROM us-docker.pkg.dev/hasura-container-images/external-images/docker.io/library/golang:1.26-bookworm-stable AS builder

WORKDIR /go/src/github.com/ory/hydra

ENV GOTOOLCHAIN=local

RUN apt-get update && apt-get upgrade -y && \
    mkdir -p ./internal/httpclient

COPY go.mod go.sum ./
COPY internal/httpclient/go.* ./internal/httpclient/

ENV CGO_ENABLED=1

RUN go mod download

COPY . .
RUN go build -trimpath \
    -ldflags="-X github.com/ory/hydra/v2/driver/config.Version=v2.3.0 -X github.com/ory/hydra/v2/driver/config.Date=$(date -u '+%Y-%m-%dT%H:%M:%SZ') -X github.com/ory/hydra/v2/driver/config.Commit=$(git rev-parse HEAD) -extldflags=-static" \
    -tags sqlite,sqlite_omit_load_extension -o /usr/bin/hydra

FROM alpine:3.23.7@sha256:ff7f0c727dd796aa36787bfcd9a64bf35a6ce72a73451b3359fde849b6703d63

RUN apk add --no-cache --upgrade ca-certificates ca-certificates-bundle \
    # Require the Alpine CA update that drops the distrusted eMudhra emSign roots.
    && for p in ca-certificates ca-certificates-bundle; do \
         [ "$(apk version -t "$(apk info -e -v $p | sed "s/^$p-//")" 20261020-r0)" != "<" ] \
           || { echo "$p older than 20261020-r0" >&2; exit 1; }; \
       done \
    && addgroup -S ory \
    && adduser -S ory -G ory -D -H -s /bin/nologin

COPY --from=builder /usr/bin/hydra /usr/bin/hydra

# set up nsswitch.conf for Go's "netgo" implementation
# - https://github.com/golang/go/blob/go1.9.1/src/net/conf.go#L194-L275
RUN echo 'hosts: files dns' > /etc/nsswitch.conf

USER ory

ENTRYPOINT ["hydra"]
CMD ["serve", "all"]
